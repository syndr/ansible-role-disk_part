flowchart TD
  A[Role entry: main.yml] --> B[Init: init.yml reset facts validate list]
  B --> C[Setup mount facts]
  C --> D{Loop disks_partitions}
  D --> E[manage_disk.yml]

  subgraph ManageDisk
    E --> E1[init_disk_config.yml merge defaults validate item]
    E1 --> E2[check_state.yml safety]
    E2 --> E3{state != absent?}
    E3 -->|No| Eskip((Skip provisioning))
    E3 -->|Yes| Pstart[Provision]
    subgraph Provision
      Pstart --> U1{Need base UUID pre-LVM?}
      U1 -->|Yes| U2[get_uuid blkid]
      U1 -->|No| U3[Proceed to LVM/filesystem]
      U2 --> U3
      U3 --> LVM{lvm?}
      LVM -->|Yes| L1[lvm.yml ensure VG/LV set /dev/vg-/lv-]
      L1 --> U4{Need UUID after LVM?}
      U4 -->|Yes| U5[get_uuid blkid+lvs]
      U4 -->|No| U6[Skip LV UUID]
      U5 -->FS
      LVM -->|No| U6
      U6 --> FS[Format filesystem]
      FS -->|Use GUID path| FAct[Update fact record]
    end
    FAct --> MountSel[Select runtime device]
    Eskip --> MountSel
    MountSel --> MType{mount_type}
    MType -->|systemd| Sys[mount_systemd.yml unit ops]
    MType -->|fstab| Fstab[mount_fstab.yml posix.mount]
    Sys --> Dup[unmount_disks.yml duplicates]
    Fstab --> Dup
    Dup --> FinalFact[Append fact]
  end

  FinalFact --> SaveBlock[Always: write facts]
  SaveBlock --> Save[Write disk_part.fact]

  E2 -->|safety fail| Fail[[Abort]]
  FS -->|use kernel dev path| MountSel

  classDef decision fill:#334155,stroke:#3b82f6,color:#f8fafc;
  classDef action fill:#1e3a8a,stroke:#3b82f6,color:#f8fafc;
  classDef terminal fill:#0f172a,stroke:#f43f5e,color:#f8fafc;
  classDef data fill:#475569,stroke:#94a3b8,color:#f8fafc;
  class A,B,C,D,E,E1,E2,E3,Pstart,U2,U3,L1,U5,FS,FAct,MountSel,MType,Sys,Fstab,Dup,FinalFact,SaveBlock,Save action;
  class U1,U4,LVM decision;
  class Eskip,Fail terminal;
